# KeeperHub
KEEPERHUB_API_KEY=
KEEPERHUB_BASE_URL=https://app.keeperhub.com

# AXL transport
AXL_TRANSPORT_MODE=mcp
AXL_NODE_URL=http://127.0.0.1:9002

# AXL peer routing
AXL_PEER_VOICE=
AXL_SERVICE_VOICE=voice
AXL_PEER_REASONING=
AXL_SERVICE_REASONING=reasoning
AXL_PEER_EXECUTION=
AXL_SERVICE_EXECUTION=execution
AXL_PEER_RESPONSE=
AXL_SERVICE_RESPONSE=response

# 0G broker-backed inference
ZERO_G_BROKER_BASE_URL=http://127.0.0.1:4000
ZERO_G_PROVIDER_ADDRESS_LLM=
ZERO_G_PROVIDER_ADDRESS_STT=
ZERO_G_PROVIDER_ADDRESS_TTS=

# Optional legacy 0G settings
ZERO_G_INFERENCE_BASE_URL=
ZERO_G_INFERENCE_API_KEY=
ZERO_G_LLM_MODEL=
ZERO_G_STT_MODEL=
ZERO_G_TTS_MODEL=