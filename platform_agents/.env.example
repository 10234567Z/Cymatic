# KeeperHub
KEEPERHUB_API_KEY=
KEEPERHUB_BASE_URL=https://app.keeperhub.com

# AXL transport
AXL_TRANSPORT_MODE=mcp
AXL_NODE_URL=http://127.0.0.1:9002
AXL_PROTOCOL_DEFAULT=mcp

# Optional per-agent protocol override: mcp or a2a
AXL_PROTOCOL_VOICE=mcp
AXL_PROTOCOL_REASONING=mcp
AXL_PROTOCOL_EXECUTION=mcp
AXL_PROTOCOL_RESPONSE=mcp

# AXL peer routing
AXL_PEER_VOICE=
AXL_SERVICE_VOICE=voice
AXL_PEER_REASONING=
AXL_SERVICE_REASONING=reasoning
AXL_PEER_EXECUTION=
AXL_SERVICE_EXECUTION=execution
AXL_PEER_RESPONSE=
AXL_SERVICE_RESPONSE=response

# Local adapter services to register in your local AXL integrations
MCP_ADAPTER_URL=http://127.0.0.1:7101/mcp
A2A_ADAPTER_URL=http://127.0.0.1:7102/a2a

# OpenAI-compatible inference (LLM / STT / TTS)
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# CallerINFT (0G Galileo testnet)
CALLER_INFT_ADDRESS=0xFB61896B0521594B49f261c96bd0313Ce32D70E7
MOCK_VERIFIER_ADDRESS=0xcD0F092986b44fB176005CdDA205c4E4BA8ED6A1
OG_RPC_URL=https://evmrpc-testnet.0g.ai
DEPLOYER_PRIVATE_KEY=
CALLER_INFT_DEPLOYER_ADDRESS=
